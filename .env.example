# RejuveLuxe — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not,
# so never put a real secret here. Full reference: ENVIRONMENT.md
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after any change — env files are read at startup.

# ----------------------------------------------------------------------------
# Required in production
# ----------------------------------------------------------------------------

# Public origin of the site, no trailing slash. Builds canonical, Open Graph
# and Twitter URLs. Inlined at build time: changing it needs a rebuild.
# Default when unset: https://rejuveluxe.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Planned — NOT read by the code yet
# ----------------------------------------------------------------------------
# The contact form currently hands off through `mailto:` and needs nothing.
# These are the values a server-side send would need. Setting them today has
# no effect.

# RESEND_API_KEY=
# CONTACT_TO_EMAIL=support@rejuveluxe.in
# CONTACT_FROM_EMAIL=
