# RejuveLuxe environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so every
# value here stays obviously fake. Full reference: ENVIRONMENT.md
#
#   cp .env.example .env
#
# `.env` rather than `.env.local` because the test and bootstrap scripts load
# it directly (`tsx --env-file=.env`). Next.js reads it too.
# Restart `npm run dev` after any change.

# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------

# Supabase Postgres, transaction pooler URI (Supabase > Connect > Transaction
# pooler). The catalogue loads from here, so without it no page renders and
# `next build` fails.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Signs admin session tokens. At least 32 characters or auth throws.
# Generate: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-openssl-rand-base64-48-output

# ----------------------------------------------------------------------------
# Optional
# ----------------------------------------------------------------------------

# Separate refresh-token secret. Unset falls back to AUTH_JWT_SECRET; set it so
# a leaked access secret cannot mint long-lived sessions.
# AUTH_JWT_REFRESH_SECRET=

# CSRF token secret. Unset falls back to AUTH_JWT_SECRET.
# AUTH_CSRF_SECRET=

# Public origin, no trailing slash. Unset uses Vercel's production URL, then
# http://localhost:3000. Inlined at build: changing it needs a rebuild.
# NEXT_PUBLIC_SITE_URL=https://rejuvelux.vercel.app

# Where the HTTP test suites send requests. Scripts only.
# BASE_URL=http://localhost:3000
